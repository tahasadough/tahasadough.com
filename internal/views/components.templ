package views

type NavLink struct {
	Href string
	Name string
}

var navLinks = []NavLink{
	{Href: "/#about", Name: "About"},
	{Href: "/#why-me", Name: "Why Me"},
	{Href: "/#contact", Name: "Contact"},
}

type WhyMeCard struct {
	IconSVG func() templ.Component
	Title   string
	Desc    string
}

var whyMeCards = []WhyMeCard{
	{clockIcon, "Efficient Workflow", "Streamlined developing process for rapid deliver without compromising quality or detail."},
	{messageIcon, "Collaborative Process", "I work closely with you, integrating your feedback to create fantastic softwares and amazing experiences"},
	{searchIcon, "Attention to Detail", "Meticulous attention to everything, ensuring a polished and cohesive final application that impresses."},
}

templ badge(label string) {
	<span class="z-40 text-sm transition-link ease-spring bg-linear-to-r from-highlight to-muted shadow-sm px-3 py-2 rounded-full">
		{ label }
	</span>
}

templ navbar() {
	<div id="navbar" class="fixed top-0 left-0 z-50 flex w-full items-center border-b border-transparent bg-elevated/60 p-4 text-sm backdrop-blur-md transition-navbar md:px-14 md:py-6 xl:px-56">
		<div class="flex flex-1 items-center">
			<a href="/" class="group z-60 flex items-center gap-2">
				<img
					src="/images/taha-sadough.webp"
					alt=""
					aria-hidden="true"
					class="size-6.5 rounded-full object-cover object-top transition-link group-hover:scale-110 group-hover:ring-2 group-hover:ring-gray/50"
					onerror="this.style.display='none'"
				/>
				<span class="font-bold transition-link group-hover:text-gray">Taha Sadough</span>
			</a>
		</div>
		<nav aria-label="Desktop navigation" class="hidden md:block">
			<ul class="flex gap-8">
				for _, link := range navLinks {
					<li>
						<a href={ link.Href } class="transition-link hover:text-gray">{ link.Name }</a>
					</li>
				}
			</ul>
		</nav>
		<div class="flex flex-1 items-center justify-end gap-4">
			<button
				id="theme-toggle"
				onclick="toggleTheme()"
				aria-label="Switch to light mode"
				class="cursor-pointer rounded-lg p-1.5 transition-link ease-spring hover:bg-highlight hover:text-gray"
			>
				<div id="theme-icon" class="transition-link">
					<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="12" cy="12" r="4"></circle><path d="M12 2v2"></path><path d="M12 20v2"></path>
						<path d="m4.93 4.93 1.41 1.41"></path><path d="m17.66 17.66 1.41 1.41"></path>
						<path d="M2 12h2"></path><path d="M20 12h2"></path>
						<path d="m6.34 17.66-1.41 1.41"></path><path d="m19.07 4.93-1.41 1.41"></path>
					</svg>
				</div>
			</button>
			@navmenu()
		</div>
	</div>
}

templ navmenu() {
	<div class="group md:hidden">
		<input type="checkbox" id="menu-toggle" class="peer sr-only"/>
		<label for="menu-toggle" class="relative z-50 flex h-5 w-6 cursor-pointer flex-col items-center justify-center gap-2" aria-label="Toggle Menu">
			<span class="h-0.5 w-full origin-center rounded-full bg-on-surface transition-all duration-300 ease-spring group-has-checked:translate-y-1.25 group-has-checked:rotate-45"></span>
			<span class="h-0.5 w-full origin-center rounded-full bg-on-surface transition-all duration-300 ease-spring group-has-checked:-translate-y-1.25 group-has-checked:-rotate-45"></span>
		</label>
		<label for="menu-toggle" class="invisible fixed inset-0 z-30 min-h-dvh opacity-0 transition-all duration-300 peer-checked:visible peer-checked:opacity-100" aria-hidden="true"></label>
		<nav id="mobile-menu" aria-label="Mobile menu" class="fixed top-0 right-0 z-40 w-full -translate-y-full border-b border-muted bg-elevated/95 backdrop-blur-lg transition-all duration-300 peer-checked:translate-y-0">
			<label for="menu-toggle" class="block">
				<ul class="space-y-5 px-5 pt-16 pb-10 text-lg">
					for _, link := range navLinks {
						<li>
							<a href={ link.Href } class="block transition-link hover:text-gray">{ link.Name }</a>
						</li>
					}
				</ul>
			</label>
		</nav>
	</div>
}

templ footer() {
	<footer class="container overflow-hidden pt-16 pb-12">
		<p class="bg-linear-to-tr from-muted to-gray bg-clip-text text-center text-4xl leading-[1.2] text-nowrap text-transparent md:text-8xl lg:text-9xl xl:text-[10.625rem] 2xl:text-[11.5625rem]">
			Taha Sadough
		</p>
	</footer>
}

templ connectLink() {
	<a href="https://github.com/tahasadough" target="_blank" rel="noopener noreferrer" class="cursor-pointer rounded-3xl font-bold transition-link hover:scale-105 hover:shadow-lg hover:bg-white hover:text-elevated light:hover:bg-black light:hover:text-white light:hover:shadow-black/20 border-gray border px-8 py-2.5">
		Connect me
	</a>
}

templ hero() {
	<section class="container flex flex-col items-center justify-center space-y-11.25 pt-36 pb-10 md:space-y-16 md:pt-30 md:pb-0 lg:space-y-25 lg:pt-35">
		<div class="flex flex-col items-center justify-center gap-9">
			@badge("Hello, I'm Taha 👋")
			<h1 class="text-center text-3xl leading-none sm:text-5xl md:text-6xl">
				<span class="animate-gradient bg-200 bg-linear-to-r from-on-surface via-gray to-on-surface bg-clip-text text-transparent">
					Software Engineer
				</span>
				<br/>
				<span class="text-gray">Architecting Scalable, High-Performance Systems &amp; APIs</span>
			</h1>
			@connectLink()
		</div>
		<div id="hero-flower" class="relative -z-50 select-none">
			<div id="hero-flower-inner">
				<img
					src="/images/metallic-flower.webp"
					alt=""
					aria-hidden="true"
					fetchpriority="high"
					class="size-90 object-cover transition-all duration-1500 ease-smooth md:size-125"
					onerror="this.style.display='none'"
				/>
			</div>
		</div>
	</section>
}

templ aboutSection() {
	<section id="about" class="container flex flex-col items-center justify-center pt-30 md:flex-col-reverse lg:flex-row">
		<div class="rounded-2xl border border-muted bg-elevated p-0 overflow-hidden sm:w-7/10 lg:w-full" style="aspect-ratio: 3/4">
			<img
				src="/images/taha-sadough.webp"
				alt="Taha Sadough, Software Engineer"
				fetchpriority="high"
				class="size-full object-cover transition-all duration-700 hover:scale-105"
				onerror="this.style.display='none'"
			/>
		</div>
		<div class="space-y-8 py-10 md:px-10">
			<div class="flex justify-center">
				@badge("About")
			</div>
			<h2 class="text-center text-2xl text-gray md:text-4xl lg:text-5xl">
				I&apos;m a <span class="text-on-surface">Software Engineer</span>
			</h2>
			<p class="text-center text-base text-gray">
				As a Software Engineer, I specialize in architecting scalable, high-performance systems. I believe in the &apos;right tool for the job&apos; philosophy. I design robust architectures tailored to the specific needs of the product&mdash;ranging from efficient, maintainable Modular Monoliths, to distributed Microservices when extreme scale demands it.
			</p>
		</div>
	</section>
}

templ clockIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="12" cy="12" r="10"></circle><path d="M12 6v6l4 2"></path>
	</svg>
}

templ messageIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<path d="M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2z"></path>
	</svg>
}

templ searchIcon() {
	<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
		<circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.34-4.34"></path>
	</svg>
}

templ featureCard(card WhyMeCard) {
	<div class="group space-y-6 rounded-2xl border border-muted bg-elevated px-8 py-10 transition-all duration-300 ease-smooth hover:-translate-y-1 hover:border-gray/50 hover:shadow-card light:hover:border-gray/30 light:hover:shadow-card-light">
		<div class="flex size-12 items-center justify-center rounded-lg border border-muted bg-highlight transition-link group-hover:border-gray/50 group-hover:bg-muted">
			<div class="transition-link group-hover:scale-110 group-hover:text-gray">
				@card.IconSVG()
			</div>
		</div>
		<h3 class="text-xl transition-link group-hover:text-gray">{ card.Title }</h3>
		<p class="text-base text-gray">{ card.Desc }</p>
	</div>
}

templ whyMeSection() {
	<section id="why-me" class="container flex flex-col items-center justify-center gap-10 pt-24 pb-20">
		@badge("Why me?")
		<h2 class="px-2 text-center text-3xl leading-none lg:px-0 lg:text-5xl">
			I create epic apps that <span class="text-gray">spark</span> your imagination!
		</h2>
		<div class="grid gap-8 md:grid-cols-3">
			for _, card := range whyMeCards {
				@featureCard(card)
			}
		</div>
	</section>
}

templ contactSection() {
	<section id="contact" class="relative flex flex-col items-center justify-center gap-7 py-32">
		@badge("Contact")
		<h2 class="text-center text-3xl lg:text-5xl">
			<span class="text-gray">Let&apos;s Get </span> in Touch
		</h2>
		<p class="text-center text-base text-gray">Let&apos;s start ASAP.</p>
		@connectLink()
		<div class="absolute inset-0 -z-10 h-full bg-surface opacity-90"></div>
		<div class="animate-blob absolute -top-20 left-0 h-2/5 w-full bg-linear-to-br from-elevated to-surface blur-3xl"></div>
		<div class="animate-blob absolute top-98 bottom-0 left-0 h-1/3 w-full bg-linear-to-br from-elevated to-surface blur-3xl" style="animation-delay: -5s; animation-duration: 12s;"></div>
		<img src="/images/metallic-shape-background.webp" alt="" aria-hidden="true" loading="lazy" class="absolute inset-0 -z-20 size-full object-cover select-none"/>
	</section>
}
