package home

import (
	"github.com/tahasadough/tahasadough.com/internal/web/components/layout"
	"github.com/tahasadough/tahasadough.com/internal/web/pages"
)

templ homeContent() {
	<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-lg focus:bg-elevated focus:px-4 focus:py-2 focus:text-on-surface focus:ring-2 focus:ring-on-surface">
		Skip to content
	</a>
	<header class="lg:container">
		@layout.Navbar()
	</header>
	<main id="main-content" aria-label="Main content">
		@hero()
		@aboutSection()
		@whyMeSection()
		@contactSection()
	</main>
	@layout.Footer()
}

templ Page() {
	@pages.Page("Taha Sadough — Software Developer",
		"Software Engineer specializing in scalable, high-performance backend systems and APIs — Go, Rust, TypeScript, distributed systems, modular monoliths to microservices.",
		homeContent())
}
