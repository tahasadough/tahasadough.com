package home

import "github.com/tahasadough/tahasadough.com/internal/web/components"

templ homeContent() {
	@hero()
	@aboutSection()
	@whyMeSection()
	@contactSection()
}

templ Page() {
	@components.MainLayout("Taha Sadough — Software Developer",
		"Software Engineer specializing in scalable, high-performance backend systems and APIs — Go, Rust, TypeScript, distributed systems, modular monoliths to microservices.",
		homeContent())
}
