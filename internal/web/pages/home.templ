package pages

import (
	"github.com/tahasadough/tahasadough.com/internal/web/components/layout"
)

templ homeContent() {
	<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-lg focus:bg-elevated focus:px-4 focus:py-2 focus:text-on-surface focus:ring-2 focus:ring-on-surface">
		Skip to content
	</a>
	<header class="lg:container">
		@layout.Navbar()
	</header>
	<main id="main-content" aria-label="Main content">
		@hero()
		@aboutSection()
		@whyMeSection()
		@contactSection()
	</main>
	@layout.Footer()
	<div id="update-notification" style="display:none">
		<button onclick="onSWUpdateClick()" class="fixed right-4 bottom-4 z-50 cursor-pointer rounded-lg bg-elevated px-4 py-2 text-sm text-on-surface shadow-lg transition-colors hover:opacity-80">
			Update available &mdash; click to refresh
		</button>
	</div>
}

templ HomePage() {
	@page("Taha Sadough", "Scalable, high-performance systems & APIs", homeContent())
}
