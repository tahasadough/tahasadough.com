package pages

import "github.com/tahasadough/tahasadough.com/static"

const jsonLDScript = `<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "Taha Sadough",
  "jobTitle": "Software Developer",
  "description": "Software Engineer specializing in scalable, high-performance backend systems and APIs.",
  "techStack": ["Go", "Rust", "TypeScript"],
  "sameAs": ["https://github.com/tahasadough"]
}
</script>`

templ head(title, desc string) {
	<head>
		<script>
			(function() {
				var theme = localStorage.getItem('theme');
				if (!theme) {
					theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
				}
				if (theme === 'light') {
					document.documentElement.classList.add('light');
				}
			})();
		</script>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<title>{ title }</title>
		<meta name="description" content={ desc }/>
		<meta name="theme-color" id="theme-color" content="#000000"/>
		<link rel="icon" href="/favicon.ico"/>
		@templ.Raw(static.StyleCSS)
		<meta name="keywords" content="software engineer, software developer, backend developer, system design, distributed systems, Go, Rust, TypeScript, APIs"/>
		@templ.Raw(jsonLDScript)
	</head>
}

templ Page(title, desc string, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en" class="overflow-x-hidden">
		@head(title, desc)
		<body
			class="overflow-x-hidden bg-surface font-sans text-on-surface antialiased"
		>
			@content
			<script type="module" src="/js/app.js"></script>
		</body>
	</html>
}
